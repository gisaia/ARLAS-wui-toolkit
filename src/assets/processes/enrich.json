          {
            "label": "Overview COG (visual bands)",
            "value": "overview_cog"
          },
          {
            "label": "All bands COG",
            "value": "all_bands_cog",
            "if": [
              {
                "field": "metadata.core.identity.collection",
                "op": "eq",
                "value": "AIRBUS-PLEIADES,SAFE"
              }
            ]
          }
        ]
      }
    }
  },
  "additionalParameters": {
    "parameters": []
  }
