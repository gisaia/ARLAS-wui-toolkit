{
  "id": "d-w",
  "version": "0.0.0",
  "title": "Download",
  "description": "Télécharger un ou plusieurs produits",
  "inputs": {
    "target_format": {
      "title": "Format",
      "description": "Format des produits téléchargés",
      "schema": {
        "type": "string",
        "enum": [
          {
            "label": "native",
            "value": "native"
          },
          {
            "label": "Jpeg2000",
            "value": "Jpeg2000"
          },
          {
            "label": "Geotiff",
            "value": "Geotiff"
          },
          {
            "label": "ZARR",
            "value": "ZARR",
            "if": [
              {
                "field": "properties.item_format",
                "op": "eq",
                "value": "SAFE"
              }
            ]
          }
        ],
        "required": true
      }
    },
    "target_projection": {
      "title": "Système de coordonées",
      "description": "Système de coordonées des produits téléchargés",
      "schema": {
        "type": "object",
        "enum": [
          {
            "label": "WGS 84",
            "value": "epsg:4326",
            "if": [
              {
                "field": "_geometry_wkt",
                "op": "within",
                "value": "-180.0,-90.0,180.0,90.0"
              }
            ]
          },
          {
            "label": "EPSG:3857",
            "value": "epsg:3857",
            "if": [
              {
                "field": "_geometry_wkt",
                "op": "within",
                "value": "-180.0,-90.0,180.0,90.0"
              }
            ]
          }
        ]
      }
    },
    "crop_wkt": {
      "title": "WKT",
      "description": "",
      "schema": {
        "type": "AOI"
      }
    }
  },
  "additionalParameters": {
    "parameters": []
  }
}